# =============================================================================
# EvalIA — inventario de variables de entorno
# Este archivo no contiene secretos reales.
#
# Entornos:
#   - Desarrollo local: .env + .env.local
#   - Staging/producción EasyPanel: panel del servicio evalia-web (runtime only;
#     la imagen se construye en GitHub Actions / GHCR, no en el VPS)
#   - Rollback: Vercel (app) + Railway (Postgres y/o app)
#   - Ventana 1 del corte: evalia-web en EasyPanel + DATABASE_URL de Railway
# =============================================================================

# --- PostgreSQL (obligatoria) ---
# EasyPanel interno (sin exposición pública):
# DATABASE_URL="postgresql://USER:PASSWORD@evalia-postgres:5432/evalia?schema=public"
# Railway (rollback): host *.rlwy.net o *.railway.internal
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/evalia?schema=public"

# --- URL pública (obligatorias en staging/producción) ---
# https://, sin barra final. Deben coincidir con el dominio del navegador.
NEXT_PUBLIC_APP_URL="https://evalia-evalia-web.wd75db.easypanel.host"
NEXTAUTH_URL="https://evalia-evalia-web.wd75db.easypanel.host"
# AUTH_URL es un alias opcional leído por getAppBaseUrl()
# AUTH_URL="https://evalia-evalia-web.wd75db.easypanel.host"

# --- Autenticación (obligatoria) ---
# Generar: openssl rand -base64 48
AUTH_SECRET="pon-aqui-un-secreto-largo-aleatorio"
# Fallback legado (opcional). Si existe, debe ser el mismo valor que AUTH_SECRET.
# NEXTAUTH_SECRET="mismo-valor-que-AUTH_SECRET"

# --- ElevenLabs (obligatorias para entrevistas de voz y webhook) ---
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_WEBHOOK_SECRET=""
# Solo desarrollo local. Nunca en producción/staging:
# ALLOW_UNSIGNED_ELEVENLABS_WEBHOOK="true"

# --- OpenAI (obligatoria para evaluaciones) ---
OPENAI_API_KEY=""
# OPENAI_EVAL_MODEL="gpt-4o-mini"

# --- Correo SMTP (opcional; invitaciones) ---
# Gmail / Google Workspace: contraseña de aplicación
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# --- Bootstrap / seed (producción: valores seguros) ---
# El arranque normal NUNCA crea usuarios demo ni cambia contraseñas.
ALLOW_DEMO_SEED="false"
DISABLE_DB_BOOTSTRAP="1"
# APPLY_SCHEMA_ON_START no se usa en el contenedor web (réplicas).
# APPLY_SCHEMA_ON_BUILD="false"
# ALLOW_ADMIN_PASSWORD_RESET="false"
# ADMIN_EMAIL="admin@evalia.app"
# ADMIN_PASSWORD=""
# INIT_ADMIN_EMAIL=""
# INIT_ADMIN_PASSWORD=""
# INIT_ADMIN_NAME="Admin EvalIA"

# --- Runtime del contenedor ---
NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"
# NEXT_TELEMETRY_DISABLED="1"

# =============================================================================
# Solo desarrollo en tu Mac (pnpm dev)
# =============================================================================
# DATABASE_URL="postgresql://postgres:clave@localhost:5432/evalia?schema=public"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXTAUTH_URL="http://localhost:3000"
# ALLOW_DEMO_SEED="true"
# DISABLE_DB_BOOTSTRAP="0"
